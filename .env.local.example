# Rename this file to .env.local and add your API keys

# OpenAI API Key - Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Email Service (for contact form)
# EMAIL_SERVICE_KEY=your-email-service-key-here

# Stripe API Keys - Get yours at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here